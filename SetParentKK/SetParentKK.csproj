<Project Sdk="Microsoft.NET.Sdk">
  <!--
    KK_SetParentVR (BepInEx 5 / HarmonyX)

    Reference assemblies are taken from ..\lib by default (Assembly-CSharp, Assembly-CSharp-firstpass, UnityEngine and
    UnityEngine.UI from <game>\KoikatuVR_Data\Managed; BepInEx and 0Harmony from <game>\BepInEx\core). Override the paths with
      dotnet build SetParentKK.csproj -c Release -p:GameManagedPath=<game>\KoikatuVR_Data\Managed -p:BepInExCorePath=<game>\BepInEx\core
    The VR assembly (KoikatuVR_Data) is required: VRHScene / VRViveController / SteamVR_Controller only exist there.
  -->
  <PropertyGroup>
    <TargetFramework>net35</TargetFramework>
    <AssemblyName>KK_SetParentVR</AssemblyName>
    <RootNamespace>SetParentKK</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <EnableDefaultItems>False</EnableDefaultItems>
    <Optimize>true</Optimize>
    <DebugType>None</DebugType>
    <GameManagedPath Condition="'$(GameManagedPath)' == ''">$(MSBuildThisFileDirectory)..\lib</GameManagedPath>
    <BepInExCorePath Condition="'$(BepInExCorePath)' == ''">$(MSBuildThisFileDirectory)..\lib</BepInExCorePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AnimSpeedController.cs" />
    <Compile Include="ConfigurationManagerAttributes.cs" />
    <Compile Include="FixBodyParts.cs" />
    <Compile Include="SetParentBodyParts.cs" />
    <Compile Include="SetParentControllerInput.cs" />
    <Compile Include="KK_SetParentVR.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SetParent.cs" />
    <Compile Include="Hooks.cs" />
    <Compile Include="SetParentUI.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCorePath)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCorePath)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManagedPath)\Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameManagedPath)\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManagedPath)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedPath)\UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
